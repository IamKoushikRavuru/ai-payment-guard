# ==============================================================================
# AI-Native Observability & Threat Detection Engine for Global Payment APIs
# Environment Configuration Template
# ==============================================================================

# Application Settings
PROJECT_NAME="AI-Native Payment Observability & Threat Detection Engine"
VERSION="1.0.0"
ENVIRONMENT="development"
DEBUG=false
HOST="0.0.0.0"
PORT=8000
LOG_LEVEL="INFO"

# External AI Provider (Optional / Fallback)
# Set your real API key here. The system validates key connectivity at startup.
# If left as placeholder or absent, the local deterministic/ML security pipeline
# and autonomous fallback agent will operate seamlessly.
AI_API_KEY=your_api_key_here
AI_PROVIDER=openai
AI_MODEL=gpt-4o-mini

# Database Configuration
# Local SQLite default for zero-dependency local runs and tests.
# For Docker/PostgreSQL: postgresql+asyncpg://postgres:postgres@localhost:5432/payment_guard
DATABASE_URL=sqlite+aiosqlite:///./payment_guard.db
SYNC_DATABASE_URL=sqlite:///./payment_guard.db

# Redis Cache & Event Streaming (Optional, degrades gracefully to in-memory pub/sub)
REDIS_URL=redis://localhost:6379/0

# Risk Engine Thresholds (0.0 to 100.0)
RISK_THRESHOLD_LOW=25.0
RISK_THRESHOLD_MEDIUM=50.0
RISK_THRESHOLD_HIGH=75.0
RISK_THRESHOLD_CRITICAL=90.0

# Financial Guardrails & Compliance Policy
MAX_TRANSACTION_AMOUNT=50000.0
MAX_DAILY_VOLUME=500000.0
MAX_FX_SPREAD_DEVIATION=0.03
BLOCKED_COUNTRIES=["KP", "IR", "CU", "SY"]
ALLOWED_CORRIDORS=["SEPA", "SWIFT", "ACH", "PIX", "FASTER_PAYMENTS", "CHAPS", "FEDNOW"]

# Security & Alerting
ALERT_COOLDOWN_SECONDS=60
ENABLE_REALTIME_STREAM=true
CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","*"]
